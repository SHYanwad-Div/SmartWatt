# Copy this file to .env (git-ignored) and fill in your values.
# Docker Compose reads docker/.env automatically. Leave a value empty to turn that feature off.

# Grafana admin password (http://localhost:3001)
GRAFANA_ADMIN_PASSWORD=admin

# Overload alerts
ALERT_THRESHOLD_W=1200
ALERT_COOLDOWN_SEC=900

# OpenWeather key for GET /weather (https://home.openweathermap.org/api_keys)
OPENWEATHER_KEY=

# Telegram alerts: bot token from @BotFather and the chat id to send to
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Email alerts over SMTP
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
ALERT_EMAIL_TO=
