# ---------- Smart Watt v2 configuration ----------
# Copy to .env and edit. Nothing here is required for the synthetic demo.

SW_HOST=0.0.0.0
SW_PORT=8000
SW_DB_PATH=data/smartwatt.db

# Data source: "sim" (synthetic, no hardware) | "mqtt" (real ESP32) | "both"
SW_SOURCE=sim
SW_SIM_INTERVAL_S=1.0

# MQTT broker (only used when SW_SOURCE includes mqtt)
SW_MQTT_HOST=localhost
SW_MQTT_PORT=1883
SW_MQTT_USER=
SW_MQTT_PASS=
SW_MQTT_READINGS_TOPIC=smartwatt/readings/#
SW_MQTT_EVENTS_TOPIC=smartwatt/events/#
SW_MQTT_CMD_TOPIC_FMT=smartwatt/cmd/{device_id}

# Auth
# Leave empty to auto-generate a random secret into data/.jwt_secret (recommended).
SW_JWT_SECRET=
# Key for POST /mock_reading from test scripts (header X-Device-Key). Empty = login required.
SW_INGEST_KEY=
SW_JWT_TTL_HOURS=12
SW_ADMIN_PASSWORD=admin123

# Alert notification channels (all optional)
SW_SMTP_HOST=
SW_SMTP_PORT=587
SW_SMTP_USER=
SW_SMTP_PASS=
SW_ALERT_EMAIL_TO=
SW_WEBHOOK_URL=
SW_TELEGRAM_BOT_TOKEN=
SW_TELEGRAM_CHAT_ID=
